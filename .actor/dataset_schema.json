{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "source": { "type": "string", "title": "Source", "example": "groww" },
      "query": { "type": "string", "title": "Query", "example": "reliance" },
      "assetType": { "type": "string", "title": "Asset Type", "example": "stock" },
      "assetTypeLabel": { "type": "string", "title": "Type", "example": "Stock" },
      "name": { "type": "string", "title": "Name", "example": "Reliance Industries" },
      "shortName": { "type": ["string", "null"], "title": "Short Name", "example": "Reliance Industries" },
      "searchId": { "type": "string", "title": "Groww Search ID", "example": "reliance-industries-ltd" },
      "symbol": { "type": ["string", "null"], "title": "Symbol / Code", "example": "RELIANCE" },
      "isin": { "type": ["string", "null"], "title": "ISIN", "example": "INE002A01018" },
      "category": { "type": ["string", "null"], "title": "Category", "example": "Oil" },
      "subCategory": { "type": ["string", "null"], "title": "Sub Category", "example": "Large Cap" },
      "logoUrl": { "type": ["string", "null"], "title": "Logo URL" },
      "growwUrl": { "type": "string", "title": "Groww URL" },
      "currency": { "type": "string", "title": "Currency", "example": "INR" },
      "priceOrNav": { "type": ["number", "null"], "title": "Price / NAV" },
      "changeOrReturn": { "type": ["number", "null"], "title": "Change / Return %" },
      "marketCapOrAum": { "type": ["number", "null"], "title": "Market Cap / AUM" },
      "peOrRating": { "type": ["number", "null"], "title": "P/E / Rating" },
      "primaryMetricLabel": { "type": "string", "title": "Primary Metric" },
      "primaryMetricValue": { "type": ["number", "null"], "title": "Primary Value" },
      "secondaryMetricLabel": { "type": "string", "title": "Secondary Metric" },
      "secondaryMetricValue": { "type": ["number", "null"], "title": "Secondary Value" },
      "tertiaryMetricLabel": { "type": "string", "title": "Tertiary Metric" },
      "tertiaryMetricValue": { "type": ["number", "null"], "title": "Tertiary Value" },
      "ratingMetricLabel": { "type": "string", "title": "Rating Metric" },
      "ratingMetricValue": { "type": ["number", "null"], "title": "Rating Value" },
      "stock": { "type": ["object", "null"], "title": "Stock Details" },
      "mutualFund": { "type": ["object", "null"], "title": "Mutual Fund Details" },
      "scrapedAt": { "type": "string", "title": "Scraped At" }
    },
    "required": ["source", "query", "assetType", "name", "searchId", "growwUrl", "currency", "scrapedAt"]
  },
  "views": {
    "overview": {
      "title": "Assets",
      "description": "Clean overview of Groww stocks and mutual funds.",
      "transformation": {
        "fields": [
          "logoUrl",
          "assetTypeLabel",
          "name",
          "symbol",
          "category",
          "subCategory",
          "currency",
          "priceOrNav",
          "changeOrReturn",
          "marketCapOrAum",
          "peOrRating"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "logoUrl": { "label": "Logo", "format": "image" },
          "assetTypeLabel": { "label": "Type", "format": "text" },
          "name": { "label": "Name", "format": "text" },
          "symbol": { "label": "Symbol", "format": "text" },
          "category": { "label": "Category", "format": "text" },
          "subCategory": { "label": "Subcategory", "format": "text" },
          "currency": { "label": "Currency", "format": "text" },
          "priceOrNav": { "label": "Price / NAV", "format": "number" },
          "changeOrReturn": { "label": "Change / 1Y %", "format": "number" },
          "marketCapOrAum": { "label": "MCap / AUM Cr", "format": "number" },
          "peOrRating": { "label": "P/E / Rating", "format": "number" }
        }
      }
    },
    "details": {
      "title": "Details",
      "description": "Full Groww records with URL and nested stock or mutual fund details.",
      "transformation": {
        "fields": [
          "assetType",
          "assetTypeLabel",
          "name",
          "searchId",
          "symbol",
          "isin",
          "category",
          "subCategory",
          "growwUrl",
          "currency",
          "priceOrNav",
          "changeOrReturn",
          "marketCapOrAum",
          "peOrRating",
          "primaryMetricLabel",
          "primaryMetricValue",
          "secondaryMetricLabel",
          "secondaryMetricValue",
          "tertiaryMetricLabel",
          "tertiaryMetricValue",
          "ratingMetricLabel",
          "ratingMetricValue",
          "stock",
          "mutualFund",
          "query",
          "scrapedAt"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "growwUrl": { "label": "Groww URL", "format": "link" },
          "stock": { "label": "Stock Details", "format": "object" },
          "mutualFund": { "label": "Mutual Fund Details", "format": "object" },
          "scrapedAt": { "label": "Scraped At", "format": "date" }
        }
      }
    }
  }
}
